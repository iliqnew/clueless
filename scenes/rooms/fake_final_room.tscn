[node name="NPC" parent="Environment" parent_id_path=PackedInt32Array(123840637) index="7" unique_id=1634797251]
position = Vector2(99, 137)
dialogue_text = "A-ha-ha-ha-ha! Sunset? Ha-ha-ha... In a dungeon. Ha-ha! Anyway... Leave me alone. I've heard it's sleeping here. I don't know what 'it' is but I could use some sleep. So I came here... Keep it quiet."

[node name="Skeleton" parent="Environment" parent_id_path=PackedInt32Array(123840637) index="9" unique_id=2063282561 instance=ExtResource("2_jbodr")]
visible = false
position = Vector2(250, 564)
script = ExtResource("3_n0etu")
dialogue_text = "You find a handwritten note in this skeleton's hand. \"They screwed me over! All of them lied to me. All but one. The one that didn't point me to a direction. But I got their secret. Remember their instructions. Go back and start over. Rotate the all directions but one 15 minutes CCW. I'm sure you'll figure it out.\""
